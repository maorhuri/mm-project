# =============================================================================
# MM Marketing OS — environment variables
# Copy to .env and fill in. NEVER commit .env. Secrets live only in .env / a
# secrets manager — never in code or Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Core (REQUIRED for Phase 1)
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="MM Marketing OS"
# Public URL of the web app (used for absolute links, OAuth callbacks later)
APP_URL=http://localhost:3000
PORT=3000
TZ=Asia/Jerusalem
DEFAULT_LOCALE=he-IL
DEFAULT_CURRENCY=ILS

# 32+ random bytes, base64. Used to sign session cookies and derive keys.
#   openssl rand -base64 48
APP_SECRET=change-me-generate-with-openssl-rand-base64-48
# 32 bytes, base64. AES-256-GCM key for encrypting stored OAuth/API tokens.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Session lifetime in days
SESSION_TTL_DAYS=30
# Require super admins and org OWNER/ADMIN users to enrol in two-factor auth (TOTP)
MFA_REQUIRED_FOR_ADMINS=false

# ---------------------------------------------------------------------------
# PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
POSTGRES_USER=mm
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=mm_marketing
# App connection string (host "postgres" inside docker, "127.0.0.1" from host)
DATABASE_URL=postgresql://mm:change-me-postgres-password@127.0.0.1:5432/mm_marketing?schema=public
# Separate DB for integration / tenant-isolation tests (created automatically)
TEST_DATABASE_URL=postgresql://mm:change-me-postgres-password@127.0.0.1:5432/mm_marketing_test?schema=public

# ---------------------------------------------------------------------------
# Redis (REQUIRED — BullMQ queues, caching, rate limiting)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Object storage — S3-compatible (REQUIRED for Media Library)
# Default: Versity S3 Gateway from docker-compose (bucket is created on first
# use). Any S3 provider works (AWS S3, Cloudflare R2, Wasabi, ...).
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mm-media
S3_ACCESS_KEY=mm-storage
S3_SECRET_KEY=change-me-storage-secret
S3_FORCE_PATH_STYLE=true
# Optional: public CDN/base URL for serving media (Cloudflare etc.). If empty,
# media is streamed through the app with access control.
MEDIA_PUBLIC_BASE_URL=
# Max upload size in MB
MEDIA_MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# Initial admin user (used by `npm run db:seed` — change after first login)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=support@mvn.co.il
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME="Maor"

# ---------------------------------------------------------------------------
# AI providers (Phase 2+). Leave empty to use clearly-labelled MOCK adapters.
# Model IDs are configured in the AI Router settings, not hard-coded.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Image / video / TTS providers (configure when enabling those modules)
IMAGE_PROVIDER=
VIDEO_PROVIDER=
TTS_PROVIDER=
# Monthly AI budget guard rails (ILS). Jobs above the cap are blocked.
AI_MONTHLY_BUDGET_ILS=500
AI_SINGLE_RUN_MAX_ILS=25

# ---------------------------------------------------------------------------
# Meta (Facebook / Instagram) — Phase 4/5. OAuth app credentials.
# Requires a Meta App with Pages/Instagram/Marketing API permissions.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
# Hard safety switch: write operations to Meta Ads are disabled unless true
META_ADS_WRITE_ENABLED=false

# ---------------------------------------------------------------------------
# Google Ads — Phase 5
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_WRITE_ENABLED=false

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
