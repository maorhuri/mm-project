// MM Marketing OS — PostgreSQL schema (Phase 1 foundation)
// Conventions: snake_case tables/columns via @map, UUID v7 primary keys,
// every brand-scoped table carries brand_id (tenant key) and is accessed
// through the tenant-scoped client in src/tenant.ts.
// Future-phase tables are designed in docs/DATABASE_SCHEMA.md and added
// per phase via migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Identity & access
// ===========================================================================

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  isActive     Boolean   @default(true) @map("is_active")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc String?   @map("mfa_secret_enc") // AES-256-GCM encrypted TOTP secret (base32)
  /// sha256 hashes of unused one-time recovery codes
  mfaRecoveryCodes String[] @default([]) @map("mfa_recovery_codes")
  mfaEnrolledAt    DateTime? @map("mfa_enrolled_at")
  /// Last accepted TOTP time-step — a code is never accepted twice
  mfaLastUsedStep  Int?      @map("mfa_last_used_step")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions           Session[]
  memberships        Membership[]
  brandAccess        BrandAccess[]
  auditLogs          AuditLog[]       @relation("AuditActor")
  uploadedMedia      MediaAsset[]     @relation("MediaUploader")
  requestedApprovals Approval[]       @relation("ApprovalRequester")
  decidedApprovals   Approval[]       @relation("ApprovalDecider")
  approvedKnowledge  BrandKnowledge[] @relation("KnowledgeApprover")
  notifications      Notification[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  tokenHash  String   @unique @map("token_hash") // sha256 of the cookie token
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships      Membership[]
  brands           Brand[]
  auditLogs        AuditLog[]
  providerAccounts ProviderAccount[]

  @@map("organizations")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

enum BrandRole {
  BRAND_ADMIN
  EDITOR
  VIEWER
}

/// Per-brand grant. Org OWNER/ADMIN implicitly have BRAND_ADMIN on all org brands;
/// MEMBER/VIEWER only see brands listed here.
model BrandAccess {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  brandId   String    @map("brand_id") @db.Uuid
  role      BrandRole @default(EDITOR)
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId])
  @@map("brand_access")
}

// ===========================================================================
// Brands (tenants)
// ===========================================================================

enum BrandStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Brand {
  id          String      @id @default(uuid(7)) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  name        String
  slug        String
  status      BrandStatus @default(ACTIVE)
  industry    String?
  description String?
  websiteUrl  String?     @map("website_url")
  locale      String      @default("he-IL")
  timezone    String      @default("Asia/Jerusalem")
  currency    String      @default("ILS")
  /// Demo brands are labelled as such everywhere in the UI.
  isDemo      Boolean     @default(false) @map("is_demo")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  settings         BrandSettings?
  assets           BrandAsset[]
  products         BrandProduct[]
  knowledge        BrandKnowledge[]
  competitors      BrandCompetitor[]
  media            MediaAsset[]
  approvals        Approval[]
  access           BrandAccess[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  providerAccounts ProviderAccount[]
  backgroundJobs   BackgroundJob[]
  aiRuns           AiRun[]
  contentIdeas     ContentIdea[]
  creativeProjects CreativeProject[]
  creativeVersions CreativeVersion[]
  strategyBriefs   StrategyBrief[]
  videoProjects    VideoProject[]
  videoScenes      VideoScene[]
  adAccounts       AdAccount[]
  campaigns        Campaign[]
  adSets           AdSet[]
  advertisements   Advertisement[]
  adInsights       AdInsight[]
  integrationSyncs IntegrationSync[]
  characters       BrandCharacter[]

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@map("brands")
}

enum PublishingMode {
  MANUAL
  SEMI_AUTO
  AUTO
}

model BrandSettings {
  id                 String         @id @default(uuid(7)) @db.Uuid
  brandId            String         @unique @map("brand_id") @db.Uuid
  /// { primary, secondary, accent, background, foreground } as hex strings
  colors             Json           @default("{}")
  /// { heading, body } font family names (must be licensed/uploaded)
  fonts              Json           @default("{}")
  /// { voice, style, language, doNots: string[] }
  tone               Json           @default("{}")
  /// [{ name, description, painPoints: string[] }]
  audiences          Json           @default("[]")
  keywords           String[]       @default([])
  hashtags           String[]       @default([])
  ctaPresets         String[]       @default([]) @map("cta_presets")
  allowedClaims      String[]       @default([]) @map("allowed_claims")
  forbiddenClaims    String[]       @default([]) @map("forbidden_claims")
  graphicStyle       String?        @map("graphic_style")
  publishingMode     PublishingMode @default(SEMI_AUTO) @map("publishing_mode")
  /// Monthly content targets, e.g. { marketingPosts: 6, professionalPosts: 4, securityPosts: 2, reels: 4 }
  contentTargets     Json           @default("{}") @map("content_targets")
  monthlyAdBudgetIls Decimal?       @map("monthly_ad_budget_ils") @db.Decimal(12, 2)
  updatedAt          DateTime       @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

enum BrandAssetType {
  LOGO_PRIMARY
  LOGO_SECONDARY
  LOGO_ICON
  FONT
  BRAND_IMAGE
}

model BrandAsset {
  id           String         @id @default(uuid(7)) @db.Uuid
  brandId      String         @map("brand_id") @db.Uuid
  type         BrandAssetType
  label        String?
  mediaAssetId String         @map("media_asset_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  brand Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([brandId, type])
  @@map("brand_assets")
}

model BrandProduct {
  id            String   @id @default(uuid(7)) @db.Uuid
  brandId       String   @map("brand_id") @db.Uuid
  name          String
  slug          String
  category      String?
  description   String?
  /// Verified feature bullet points only — the AI must not invent features
  features      Json     @default("[]")
  /// Target audiences for this product line
  audiences     Json     @default("[]")
  priceFromIls  Decimal? @map("price_from_ils") @db.Decimal(12, 2)
  pricingNote   String?  @map("pricing_note")
  url           String?
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, slug])
  @@index([brandId, isActive])
  @@map("brand_products")
}

enum KnowledgeKind {
  WEBSITE
  SERVICE_PAGE
  PRICING
  FAQ
  DOCUMENT
  MANUAL
  CREATIVE
  CAMPAIGN_DATA
}

enum KnowledgeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Brand knowledge base. Only APPROVED entries may be used by AI agents.
model BrandKnowledge {
  id           String          @id @default(uuid(7)) @db.Uuid
  brandId      String          @map("brand_id") @db.Uuid
  kind         KnowledgeKind
  status       KnowledgeStatus @default(PENDING)
  title        String
  sourceUrl    String?         @map("source_url")
  content      String
  approvedById String?         @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?       @map("approved_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  brand      Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("KnowledgeApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([brandId, status])
  @@map("brand_knowledge")
}

model BrandCompetitor {
  id         String   @id @default(uuid(7)) @db.Uuid
  brandId    String   @map("brand_id") @db.Uuid
  name       String
  websiteUrl String?  @map("website_url")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("brand_competitors")
}

// ===========================================================================
// Media library
// ===========================================================================

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  FONT
  DOCUMENT
  OTHER
}

enum MediaSource {
  UPLOAD
  AI_GENERATED
  RENDERED
  IMPORTED
}

model MediaAsset {
  id             String      @id @default(uuid(7)) @db.Uuid
  brandId        String      @map("brand_id") @db.Uuid
  kind           MediaKind
  source         MediaSource @default(UPLOAD)
  /// Object key in the S3 bucket; always prefixed with brands/<brandId>/
  storageKey     String      @unique @map("storage_key")
  bucket         String
  mimeType       String      @map("mime_type")
  sizeBytes      Int         @map("size_bytes")
  width          Int?
  height         Int?
  durationMs     Int?        @map("duration_ms")
  originalName   String      @map("original_name")
  title          String?
  altText        String?     @map("alt_text")
  tags           String[]    @default([])
  checksumSha256 String?     @map("checksum_sha256")
  uploadedById   String?     @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  deletedAt      DateTime?   @map("deleted_at")

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  brandAssets BrandAsset[]

  @@index([brandId, kind, deletedAt])
  @@index([brandId, createdAt])
  @@map("media_assets")
}

// ===========================================================================
// Approvals (every publish / spend / costly AI action goes through here)
// ===========================================================================

enum ApprovalType {
  CONTENT_POST
  VIDEO
  CONTENT_PLAN
  CAMPAIGN
  BUDGET
  AD_CHANGE
  ACTIVATION
  AI_HIGH_COST
  BRAND_KNOWLEDGE
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SCHEDULED
  EXECUTED
  FAILED
}

model Approval {
  id               String         @id @default(uuid(7)) @db.Uuid
  brandId          String         @map("brand_id") @db.Uuid
  type             ApprovalType
  status           ApprovalStatus @default(PENDING)
  title            String
  summary          String?
  /// Polymorphic subject (e.g. "media_asset", "brand_knowledge", later "scheduled_post")
  subjectType      String         @map("subject_type")
  subjectId        String         @map("subject_id")
  /// Approval is bound to a specific version; a material change requires a new approval
  subjectVersion   Int            @default(1) @map("subject_version")
  payload          Json           @default("{}")
  estimatedCostIls Decimal?       @map("estimated_cost_ils") @db.Decimal(12, 2)
  requestedById    String?        @map("requested_by_id") @db.Uuid
  decidedById      String?        @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?      @map("decided_at")
  decisionNote     String?        @map("decision_note")
  executedAt       DateTime?      @map("executed_at")
  errorMessage     String?        @map("error_message")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  brand       Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([brandId, status, createdAt])
  @@index([subjectType, subjectId])
  @@map("approvals")
}

// ===========================================================================
// Integrations registry (credentials encrypted at rest)
// ===========================================================================

enum ProviderKind {
  AI_TEXT
  AI_IMAGE
  AI_VIDEO
  AI_TTS
  META
  GOOGLE_ADS
  LINKEDIN
  GOOGLE_BUSINESS
  STORAGE
  OTHER
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  EXPIRED
}

model ProviderAccount {
  id                String           @id @default(uuid(7)) @db.Uuid
  orgId             String           @map("org_id") @db.Uuid
  /// null = organization-wide (e.g. an AI provider key shared by all brands)
  brandId           String?          @map("brand_id") @db.Uuid
  provider          String // "openai" | "anthropic" | "google" | "meta" | "google_ads" | ...
  kind              ProviderKind
  label             String
  status            ConnectionStatus @default(DISCONNECTED)
  externalAccountId String?          @map("external_account_id")
  scopes            String[]         @default([])
  /// AES-256-GCM encrypted JSON blob (tokens, refresh tokens, keys)
  credentialsEnc    String?          @map("credentials_enc")
  metadata          Json             @default("{}")
  expiresAt         DateTime?        @map("expires_at")
  lastSyncAt        DateTime?        @map("last_sync_at")
  lastError         String?          @map("last_error")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brand Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([orgId, provider])
  @@index([brandId])
  @@map("provider_accounts")
}

// ===========================================================================
// Operations: background jobs, audit, notifications
// ===========================================================================

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Durable record of worker executions (BullMQ keeps live state in Redis).
model BackgroundJob {
  id         String    @id @default(uuid(7)) @db.Uuid
  brandId    String?   @map("brand_id") @db.Uuid
  queue      String
  name       String
  bullJobId  String?   @map("bull_job_id")
  /// Idempotency key prevents duplicate side effects (double publish, double spend)
  idempotencyKey String? @unique @map("idempotency_key")
  status     JobStatus @default(QUEUED)
  payload    Json      @default("{}")
  result     Json?
  error      String?
  attempts   Int       @default(0)
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([queue, status, createdAt])
  @@index([brandId, createdAt])
  @@map("background_jobs")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  brandId     String?  @map("brand_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String // e.g. "brand.create", "media.delete", "approval.approve"
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  brand Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  actor User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([brandId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  brandId   String?           @map("brand_id") @db.Uuid
  level     NotificationLevel @default(INFO)
  title     String
  body      String?
  link      String?
  readAt    DateTime?         @map("read_at")
  createdAt DateTime          @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([brandId, createdAt])
  @@map("notifications")
}

// ===========================================================================
// Phase 2 — AI engine (runs ledger), ideas, creatives, strategy briefs
// ===========================================================================

enum AiTaskType {
  PROVIDER_PROBE
  CREATIVE_IDEAS
  CREATIVE_COPY
  CREATIVE_BACKGROUND
  QA_CLAIM_JUDGE
  STRATEGY_BRIEF
  VIDEO_SCRIPT
  TTS
  OTHER
  VIDEO_CLIP
  AVATAR_VIDEO
  CHARACTER_IMAGE
}

enum AiRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

/// Every model call, with its cost in ILS — the AI cost ledger.
model AiRun {
  id            String      @id @default(uuid(7)) @db.Uuid
  brandId       String      @map("brand_id") @db.Uuid
  task          AiTaskType
  provider      String
  modelId       String      @map("model_id")
  status        AiRunStatus @default(RUNNING)
  inputTokens   Int?        @map("input_tokens")
  outputTokens  Int?        @map("output_tokens")
  images        Int?
  characters    Int?
  /// Seconds of generated video (video clips / talking avatars)
  videoSeconds  Float?      @map("video_seconds")
  costIls       Decimal     @default(0) @map("cost_ils") @db.Decimal(12, 4)
  costUsd       Decimal?    @map("cost_usd") @db.Decimal(12, 6)
  /// True when the cost is an estimate (provider returned no usage)
  estimated     Boolean     @default(false)
  latencyMs     Int?        @map("latency_ms")
  promptHash    String?     @map("prompt_hash")
  factsHash     String?     @map("facts_hash")
  error         String?
  metadata      Json        @default("{}")
  requestedById String?     @map("requested_by_id") @db.Uuid
  approvalId    String?     @map("approval_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@index([brandId, status])
  @@map("ai_runs")
}

enum IdeaStatus {
  NEW
  SELECTED
  USED
  DISCARDED
}

model ContentIdea {
  id              String     @id @default(uuid(7)) @db.Uuid
  brandId         String     @map("brand_id") @db.Uuid
  productId       String?    @map("product_id") @db.Uuid
  title           String
  hook            String
  angle           String?
  /// English visual direction for the image model (never contains text to render)
  visualDirection String?    @map("visual_direction")
  /// { headline, subheadline, body?, cta, price? }
  copy            Json       @default("{}")
  /// [{ text, factIds[] }] — every factual statement cites approved fact ids
  claims          Json       @default("[]")
  qa              Json?
  status          IdeaStatus @default(NEW)
  source          String     @default("ai")
  aiRunId         String?    @map("ai_run_id") @db.Uuid
  factsHash       String?    @map("facts_hash")
  brief           Json       @default("{}")
  createdAt       DateTime   @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, status, createdAt])
  @@map("content_ideas")
}

enum CreativeChannel {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  LINKEDIN
  GENERIC
}

enum CreativeFormat {
  POST
  STORY
  BANNER
  AD
}

enum AspectRatio {
  R1X1
  R4X5
  R9X16
  R16X9
  R191X1
}

enum CreativeStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum RenderStatus {
  PENDING
  RENDERING
  READY
  FAILED
}

enum VersionStatus {
  DRAFT
  READY
  APPROVED
  REJECTED
  SUPERSEDED
}

model CreativeProject {
  id               String          @id @default(uuid(7)) @db.Uuid
  brandId          String          @map("brand_id") @db.Uuid
  title            String
  channel          CreativeChannel @default(GENERIC)
  format           CreativeFormat  @default(POST)
  aspect           AspectRatio     @default(R1X1)
  status           CreativeStatus  @default(DRAFT)
  productId        String?         @map("product_id") @db.Uuid
  ideaId           String?         @map("idea_id") @db.Uuid
  goal             String?
  audience         String?
  style            String?
  currentVersionId String?         @map("current_version_id") @db.Uuid
  createdById      String?         @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  brand    Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions CreativeVersion[]

  @@index([brandId, status, updatedAt])
  @@map("creative_projects")
}

/// Editable source document (layers) + its renders. Approval binds to a version.
model CreativeVersion {
  id             String        @id @default(uuid(7)) @db.Uuid
  brandId        String        @map("brand_id") @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  version        Int
  /// CreativeDocument v1 (see packages/core/src/creative/document.ts)
  document       Json
  copy           Json          @default("{}")
  qa             Json?
  renderStatus   RenderStatus  @default(PENDING) @map("render_status")
  renderError    String?       @map("render_error")
  renderWarnings Json?         @map("render_warnings")
  renderedPngId  String?       @map("rendered_png_id") @db.Uuid
  renderedJpgId  String?       @map("rendered_jpg_id") @db.Uuid
  renderedWebpId String?       @map("rendered_webp_id") @db.Uuid
  status         VersionStatus @default(DRAFT)
  approvalId     String?       @map("approval_id") @db.Uuid
  factsHash      String?       @map("facts_hash")
  note           String?
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  brand   Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  project CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([brandId, status])
  @@map("creative_versions")
}

enum BriefKind {
  GOALS
  AUDIENCES
  CAMPAIGN_PROPOSAL
  CONTENT_PLAN
}

enum BriefStatus {
  DRAFT
  ACCEPTED
  ARCHIVED
}

/// Strategy agent output: every item carries its data basis (fact ids) and a confidence level.
model StrategyBrief {
  id          String      @id @default(uuid(7)) @db.Uuid
  brandId     String      @map("brand_id") @db.Uuid
  kind        BriefKind
  title       String
  content     Json
  factsHash   String?     @map("facts_hash")
  aiRunId     String?     @map("ai_run_id") @db.Uuid
  status      BriefStatus @default(DRAFT)
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, kind, createdAt])
  @@map("strategy_briefs")
}

// ===========================================================================
// Phase 3 — Video studio
// ===========================================================================

enum VideoStatus {
  DRAFT
  SCRIPTED
  RENDERING
  READY
  FAILED
  APPROVED
}

enum SceneVisualKind {
  CARD
  MEDIA
  AI_IMAGE
  /// A video clip from the media library
  MEDIA_VIDEO
  /// Motion clip generated by a video model (image-to-video from the scene image, or text-to-video)
  AI_VIDEO
  /// A brand character speaking the narration (audio-driven lip-sync)
  AVATAR
}

model VideoProject {
  id               String      @id @default(uuid(7)) @db.Uuid
  brandId          String      @map("brand_id") @db.Uuid
  title            String
  goal             String?
  productId        String?     @map("product_id") @db.Uuid
  aspect           AspectRatio @default(R9X16)
  status           VideoStatus @default(DRAFT)
  voice            String      @default("alloy")
  language         String      @default("he")
  voiceoverMediaId String?     @map("voiceover_media_id") @db.Uuid
  outputMediaId    String?     @map("output_media_id") @db.Uuid
  subtitlesSrt     String?     @map("subtitles_srt")
  durationMs       Int?        @map("duration_ms")
  costIls          Decimal     @default(0) @map("cost_ils") @db.Decimal(12, 4)
  renderProgress   Int         @default(0) @map("render_progress")
  renderStep       String?     @map("render_step")
  renderError      String?     @map("render_error")
  qa               Json?
  approvalId       String?     @map("approval_id") @db.Uuid
  factsHash        String?     @map("facts_hash")
  /// Subtle zoom/pan ("Ken Burns") on still scenes
  motionStills     Boolean     @default(true) @map("motion_stills")
  /// Model tier for AI video clips / avatars: economy | balanced | flagship
  videoTier        String      @default("balanced") @map("video_tier")
  /// Keep the video model's native sound (mixed low under the narration)
  ambientAudio     Boolean     @default(false) @map("ambient_audio")
  /// AI_HIGH_COST approval that covers an expensive render (estimate above the single-run cap)
  renderApprovalId String?     @map("render_approval_id") @db.Uuid
  estimateIls      Decimal?    @map("estimate_ils") @db.Decimal(12, 4)
  createdById      String?     @map("created_by_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  brand  Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  scenes VideoScene[]

  @@index([brandId, status, updatedAt])
  @@map("video_projects")
}

model VideoScene {
  id              String          @id @default(uuid(7)) @db.Uuid
  brandId         String          @map("brand_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  order           Int
  narration       String
  onScreenText    String?         @map("on_screen_text")
  visualKind      SceneVisualKind @default(CARD) @map("visual_kind")
  mediaId         String?         @map("media_id") @db.Uuid
  visualPrompt    String?         @map("visual_prompt")
  renderedImageId String?         @map("rendered_image_id") @db.Uuid
  audioMediaId    String?         @map("audio_media_id") @db.Uuid
  durationMs      Int?            @map("duration_ms")
  /// AI_VIDEO: camera movement / action ("slow dolly-in, the robot waves")
  motionPrompt    String?         @map("motion_prompt")
  /// AVATAR (required) / AI_VIDEO (optional reference): brand character
  characterId     String?         @map("character_id") @db.Uuid
  /// Generated (or library) motion clip used as the scene background
  clipMediaId     String?         @map("clip_media_id") @db.Uuid
  /// { provider, model, seconds, costIls, cacheKey, mock }
  clipMeta        Json?           @map("clip_meta")
  createdAt       DateTime        @default(now()) @map("created_at")

  brand   Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@map("video_scenes")
}

// ===========================================================================
// Phase 5 (pulled forward) — Meta ads, read-only mirror
// ===========================================================================

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// An advertising account connected to a brand (Meta today; Google later).
model AdAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  brandId           String   @map("brand_id") @db.Uuid
  provider          String
  /// Provider id, e.g. "act_1234567890"
  externalId        String   @map("external_id")
  name              String
  currency          String?
  timezone          String?
  accountStatus     Int?     @map("account_status")
  /// The ad account the brand's dashboards use (one per provider)
  isSelected        Boolean  @default(false) @map("is_selected")
  providerAccountId String?  @map("provider_account_id") @db.Uuid
  syncedAt          DateTime? @map("synced_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([brandId, provider, externalId])
  @@map("ad_accounts")
}

model Campaign {
  id              String    @id @default(uuid(7)) @db.Uuid
  brandId         String    @map("brand_id") @db.Uuid
  adAccountId     String    @map("ad_account_id") @db.Uuid
  externalId      String    @map("external_id")
  name            String
  objective       String?
  status          String?
  effectiveStatus String?   @map("effective_status")
  /// Budgets in the account currency (major units)
  dailyBudget     Decimal?  @map("daily_budget") @db.Decimal(14, 2)
  lifetimeBudget  Decimal?  @map("lifetime_budget") @db.Decimal(14, 2)
  startTime       DateTime? @map("start_time")
  stopTime        DateTime? @map("stop_time")
  raw             Json      @default("{}")
  syncedAt        DateTime  @default(now()) @map("synced_at")

  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adSets    AdSet[]

  @@unique([adAccountId, externalId])
  @@index([brandId, effectiveStatus])
  @@map("campaigns")
}

model AdSet {
  id               String    @id @default(uuid(7)) @db.Uuid
  brandId          String    @map("brand_id") @db.Uuid
  campaignId       String    @map("campaign_id") @db.Uuid
  externalId       String    @map("external_id")
  name             String
  status           String?
  effectiveStatus  String?   @map("effective_status")
  dailyBudget      Decimal?  @map("daily_budget") @db.Decimal(14, 2)
  lifetimeBudget   Decimal?  @map("lifetime_budget") @db.Decimal(14, 2)
  optimizationGoal String?   @map("optimization_goal")
  billingEvent     String?   @map("billing_event")
  startTime        DateTime? @map("start_time")
  endTime          DateTime? @map("end_time")
  raw              Json      @default("{}")
  syncedAt         DateTime  @default(now()) @map("synced_at")

  brand    Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Advertisement[]

  @@unique([campaignId, externalId])
  @@map("ad_sets")
}

model Advertisement {
  id              String   @id @default(uuid(7)) @db.Uuid
  brandId         String   @map("brand_id") @db.Uuid
  adSetId         String   @map("ad_set_id") @db.Uuid
  externalId      String   @map("external_id")
  name            String
  status          String?
  effectiveStatus String?  @map("effective_status")
  creativeId      String?  @map("creative_id")
  thumbnailUrl    String?  @map("thumbnail_url")
  raw             Json     @default("{}")
  syncedAt        DateTime @default(now()) @map("synced_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  adSet AdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@unique([adSetId, externalId])
  @@map("advertisements")
}

/// Daily performance rows exactly as the provider reported them (source + sync time on every row).
model AdInsight {
  id               String   @id @default(uuid(7)) @db.Uuid
  brandId          String   @map("brand_id") @db.Uuid
  provider         String
  /// "account" | "campaign" | "adset" | "ad"
  level            String
  objectExternalId String   @map("object_external_id")
  objectName       String?  @map("object_name")
  date             DateTime @db.Date
  spend            Decimal  @default(0) @db.Decimal(14, 4)
  currency         String?
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  reach            Int      @default(0)
  cpc              Decimal? @db.Decimal(14, 4)
  cpm              Decimal? @db.Decimal(14, 4)
  ctr              Decimal? @db.Decimal(10, 4)
  /// [{ action_type, value }]
  actions          Json     @default("[]")
  syncedAt         DateTime @default(now()) @map("synced_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, provider, level, objectExternalId, date])
  @@index([brandId, level, date])
  @@map("ad_insights")
}

model IntegrationSync {
  id         String     @id @default(uuid(7)) @db.Uuid
  brandId    String     @map("brand_id") @db.Uuid
  provider   String
  kind       String
  status     SyncStatus @default(RUNNING)
  startedAt  DateTime   @default(now()) @map("started_at")
  finishedAt DateTime?  @map("finished_at")
  stats      Json       @default("{}")
  error      String?
  startedById String?   @map("started_by_id") @db.Uuid

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, provider, startedAt])
  @@map("integration_syncs")
}

// ===========================================================================
// Phase 3+ — brand characters (recurring mascots / presenters for videos)
// ===========================================================================

model BrandCharacter {
  id                String   @id @default(uuid(7)) @db.Uuid
  brandId           String   @map("brand_id") @db.Uuid
  name              String
  /// Appearance + personality, used in video prompts (English works best for video models)
  description       String?
  /// Reference image (portrait / bust works best for talking avatars)
  imageMediaId      String   @map("image_media_id") @db.Uuid
  /// OpenAI TTS voice used when the character speaks
  voice             String   @default("alloy")
  voiceInstructions String?  @map("voice_instructions")
  isActive          Boolean  @default(true) @map("is_active")
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, isActive])
  @@map("brand_characters")
}
