{
  "name": "@mm/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and tenant-scoped database client",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "reset": "prisma migrate reset --force",
    "seed": "tsx ../core/src/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config ../../eslint.config.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx ../core/src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  }
}
